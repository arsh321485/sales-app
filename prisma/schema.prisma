// Sales Pipeline — flexible activity-based model (Simplified Developer Workflow)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String
  // SuperAdmin | SalesManager | SalesMember | SocialMediaManager | Viewer
  role         String
  teamId       String?  @db.ObjectId
  team         Team?    @relation(fields: [teamId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  ownedLeads       Lead[]           @relation("LeadOwner")
  activities       Activity[]
  clientRequests   ClientRequest[]  @relation("RequestOwner")
  opportunities    Opportunity[]    @relation("OppOwner")
  notifications    Notification[]
  uploadedDocs     Document[]
  importLogs       ImportLog[]
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  code         String   @unique // VF, GM, GD, AI, TMP
  name         String // VaptFix, GRCMentor, ...
  prefix       String // same as code used in Lead ID
  nextNumber   Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  leads        Lead[]
  resources    SalesResource[]
  targets      RevenueTarget[]
}

model Organization {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgName       String
  websiteDomain String?
  industry      String?
  city          String?
  state         String?
  country       String   @default("India")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)

  contacts Contact[]
  leads    Lead[]

  @@index([orgName])
}

model Contact {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  fullName       String
  designation    String?
  email          String?
  phone          String?
  linkedinUrl    String?
  isPrimary      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isDeleted      Boolean      @default(false)

  leads Lead[]

  @@index([organizationId])
  @@index([email])
}

model Lead {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  leadCode         String   @unique // VF001, GM001, ...
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id])
  productId        String   @db.ObjectId
  product          Product  @relation(fields: [productId], references: [id])
  contactId        String?  @db.ObjectId
  contact          Contact? @relation(fields: [contactId], references: [id])
  ownerId          String?  @db.ObjectId
  owner            User?    @relation("LeadOwner", fields: [ownerId], references: [id])

  // New → Qualified → Engaged → Opportunity → Negotiation → Won | Lost | OnHold
  salesStage       String   @default("New")
  // Hot | Warm | Cold
  temperature      String?
  qualification    String? // Qualified | Unqualified | Pending
  source           String?
  campaign         String?
  painPoint        String?
  status           String   @default("Open")
  notes            String?
  nextAction       String?
  nextFollowUpAt   DateTime?

  wonValue         Float?
  closedAt         DateTime?
  lostReason       String?
  competitor       String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isDeleted        Boolean  @default(false)

  activities     Activity[]
  followUps      FollowUp[]
  meetings       Meeting[]
  demos          Demo[]
  requirements   Requirement[]
  clientRequests ClientRequest[]
  opportunities  Opportunity[]
  documents      Document[]
  notifications  Notification[]

  @@index([ownerId])
  @@index([productId])
  @@index([salesStage])
  @@index([organizationId])
}

model Activity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId      String   @db.ObjectId
  lead        Lead     @relation(fields: [leadId], references: [id])
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  // Outreach | FollowUp | Meeting | Demo | Requirement | ClientRequest | Proposal | Pricing | Note | Other | StageChange | Import
  activityType String
  title       String
  detail      String?
  occurredAt  DateTime @default(now())
  metaJson    String? // optional JSON extras

  @@index([leadId])
  @@index([occurredAt])
}

model FollowUp {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId         String    @db.ObjectId
  lead           Lead      @relation(fields: [leadId], references: [id])
  followUpNumber Int       @default(1)
  ownerId        String?   @db.ObjectId
  dueAt          DateTime?
  completedAt    DateTime?
  // Pending | Completed | Rescheduled | Overdue | Cancelled
  status         String    @default("Pending")
  notes          String?
  nextAction     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([dueAt])
}

model Meeting {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId       String    @db.ObjectId
  lead         Lead      @relation(fields: [leadId], references: [id])
  ownerId      String?   @db.ObjectId
  meetingType  String?
  scheduledAt  DateTime?
  participants String?
  status       String    @default("Scheduled")
  outcome      String?
  notes        String?
  nextAction   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
}

model Demo {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId                String    @db.ObjectId
  lead                  Lead      @relation(fields: [leadId], references: [id])
  ownerId               String?   @db.ObjectId
  scheduledAt           DateTime?
  participants          String?
  status                String    @default("Scheduled")
  feedback              String?
  interestLevel         String?
  requirementsIdentified String?
  nextAction            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
}

model Requirement {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId                String   @db.ObjectId
  lead                  Lead     @relation(fields: [leadId], references: [id])
  requirementType       String?
  description           String?
  businessRequirement   String?
  technicalRequirement  String?
  scope                 String?
  timeline              String?
  budget                String?
  decisionMaker         String?
  status                String   @default("Open")
  notes                 String?
  nextAction            String?
  receivedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([leadId])
}

model ClientRequest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId       String    @db.ObjectId
  lead         Lead      @relation(fields: [leadId], references: [id])
  ownerId      String?   @db.ObjectId
  owner        User?     @relation("RequestOwner", fields: [ownerId], references: [id])
  // proposal | pricing | presentation | company_profile | brochure | case_study | technical_doc | nda | sow | agreement | other
  requestType  String
  title        String
  status       String    @default("Open") // Open | In Progress | Sent | Completed | Cancelled
  priority     String    @default("High")
  resourceId   String?   @db.ObjectId
  resource     SalesResource? @relation(fields: [resourceId], references: [id])
  sentAt       DateTime?
  sentById     String?   @db.ObjectId
  notes        String?
  dueAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId])
  @@index([ownerId])
  @@index([status])
}

model SalesResource {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id])
  // Proposal | Presentation | Pricing | Case Study | Other
  resourceType String
  title       String
  sharePointUrl String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  clientRequests ClientRequest[]

  @@index([productId])
  @@index([resourceType])
}

model Opportunity {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId             String    @db.ObjectId
  lead               Lead      @relation(fields: [leadId], references: [id])
  ownerId            String?   @db.ObjectId
  owner              User?     @relation("OppOwner", fields: [ownerId], references: [id])
  opportunityValue   Float?
  probability        Int?
  expectedClosureDate DateTime?
  negotiationStatus  String?
  salesStage         String    @default("Opportunity")
  notes              String?
  nextAction         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([leadId])
  @@index([ownerId])
}

model RevenueTarget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // annual | quarterly | monthly
  periodType String
  year      Int
  quarter   Int?
  month     Int?
  // team | individual | product | company
  scopeType String   @default("company")
  teamId    String?  @db.ObjectId
  userId    String?  @db.ObjectId
  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])
  amount    Float
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([productId])
}

model Document {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId       String?  @db.ObjectId
  lead         Lead?    @relation(fields: [leadId], references: [id])
  title        String
  documentType String
  fileName     String?
  storagePath  String?
  sharePointUrl String?
  fileSize     Int?
  mimeType     String?
  uploadedById String?  @db.ObjectId
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
  isDeleted    Boolean  @default(false)

  @@index([leadId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  leadId    String?  @db.ObjectId
  lead      Lead?    @relation(fields: [leadId], references: [id])
  eventType String
  title     String
  body      String?
  priority  String   @default("Normal") // High | Medium | Normal
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ImportLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  source          String   @default("Excel")
  fileName        String?
  productId       String?  @db.ObjectId
  importedById    String?  @db.ObjectId
  importedBy      User?    @relation(fields: [importedById], references: [id])
  successCount    Int      @default(0)
  skippedCount    Int      @default(0)
  errorCount      Int      @default(0)
  errorSummary    String?
  createdAt       DateTime @default(now())
}
